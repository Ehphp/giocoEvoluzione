VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Internal FLUX laboratory route (#creature-transformation-lab). Also requires the server-side
# allowlist below: a VITE flag alone is never sufficient.
VITE_CREATURE_TRANSFORMATION_LAB_ENABLED=false

# --- Server-only (Edge Function) -------------------------------------------------------------
# Profiles allowed to reach the internal Lab operations.
CREATURE_TRANSFORMATION_LAB_PROFILE_IDS=
# Profiles allowed to spend on image generation, beside the profiles.can_generate_images flag.
CREATURE_TRANSFORMATION_REAL_IMAGE_ALLOWED_PROFILE_IDS=
# FLUX production pipeline (fal.ai image edit + OpenAI micro-concept).
FAL_FLUX_API_KEY=
FAL_FLUX_MODEL=fal-ai/flux-2-klein/9b/edit
FAL_FLUX_ESTIMATED_COST_USD=
FAL_FLUX_MAX_ESTIMATED_COST_USD=
# Gameplay stays on FLUX unless this explicit server-side switch is set to `seedream`.
CREATURE_EVOLUTION_IMAGE_PIPELINE=flux
# Seedream production uses a fixed `fal-ai/bytedance/seedream/v4.5/edit` portrait contract.
# Set provider credentials only with Supabase Edge Function secrets. Never put a value in this file.
FAL_SEEDREAM_API_KEY=
FAL_SEEDREAM_TIMEOUT_MS=30000
FAL_SEEDREAM_SUBMISSION_SOURCE_URL_TTL_SECONDS=3600
SEEDREAM_ESTIMATED_COST_PER_GENERATION=
SEEDREAM_MAX_ESTIMATED_COST_PER_GENERATION=
# Enables Seedream body-plan changes in the production-test gameplay pipeline.
SEEDREAM_STRUCTURAL_MUTATIONS_ENABLED=false
OPENAI_API_KEY=
FLUX_MICRO_CONCEPT_MODEL=
# Optional server-only visual inspection provider.
GEMINI_API_KEY=
# Server-only callback and internal finalization credentials. Generate distinct long random values.
FAL_WEBHOOK_CALLBACK_TOKEN=
FAL_FINALIZER_SHARED_SECRET=
# Required by resolve-round whenever FINE_DEL_MONDO is activated. Set only as a
# Supabase Edge Function secret; never expose it through a VITE_ variable.
COMBAT_MUTATION_RNG_SECRET=
# Structural topology changes (ADD_LIMB_PAIR, BIPEDAL_TRANSITION, ...). Off in normal gameplay.
CREATURE_EVOLUTION_BODY_PLAN_MUTATION_ENABLED=false
